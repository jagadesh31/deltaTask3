<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Digital Ticket</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #050301;
      color: #ffffff;
    }
    .ticket-container {
      width: 700px;
      margin: 40px auto;
      background-color: #111;
      border-radius: 16px;
      border: 1px solid #333;
      overflow: hidden;
    }
    .header {
      background-color: #4242FA;
      padding: 20px 30px;
      text-align: center;
      position: relative;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #fff;
    }
    .content-area {
      display: flex;
      padding: 0;
    }
    .poster-col {
      width: 40%;
      background-color: #000;
      border-right: 1px solid #333;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .poster-col img.poster {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .info-col {
      width: 60%;
      padding: 30px;
      display: flex;
      flex-direction: column;
    }
    .greeting {
      font-size: 18px;
      color: #aaa;
      margin-top: 0;
      margin-bottom: 20px;
    }
    .greeting span {
      color: #fff;
      font-weight: bold;
    }
    .detail-row {
      margin-bottom: 12px;
    }
    .detail-label {
      font-size: 12px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
      display: block;
    }
    .detail-value {
      font-size: 16px;
      font-weight: bold;
      color: #eee;
    }
    .qr-section {
      margin-top: auto;
      padding-top: 20px;
      border-top: 1px dashed #444;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .qr-text {
      font-size: 14px;
      color: #aaa;
    }
    .qr-col img {
      border-radius: 8px;
      border: 2px solid #fff;
    }
    .footer {
      text-align: center;
      padding: 15px;
      background-color: #0a0a0a;
      border-top: 1px solid #333;
      font-size: 12px;
      color: #666;
    }
  </style>
</head>
<body>
  <div class="ticket-container">
    <div class="header">
      <h1>Booking Confirmed</h1>
    </div>

    <div class="content-area">
      <div class="poster-col">
        {{#if metaData.poster}}
          <img src="{{metaData.poster}}" alt="Poster" class="poster" />
        {{else}}
          <div style="color: #666; font-size: 20px; font-weight: bold; padding: 20px; text-align: center; text-transform: uppercase;">{{purpose}}</div>
        {{/if}}
      </div>

      <div class="info-col">
        <p class="greeting">Hello <span>{{user}}</span>,</p>

        <div class="detail-row">
          <span class="detail-label">Amount Paid</span>
          <span class="detail-value" style="color: #4242FA;">₹{{amount}}</span>
        </div>

        {{#if (eq purpose "movie")}}
          <div class="detail-row">
            <span class="detail-label">Movie</span>
            <span class="detail-value">{{metaData.movie}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Theater</span>
            <span class="detail-value">{{metaData.theater}}</span>
          </div>
        {{else if (eq purpose "concert")}}
          <div class="detail-row">
            <span class="detail-label">Concert</span>
            <span class="detail-value">{{metaData.concertName}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Venue</span>
            <span class="detail-value">{{metaData.venue}}</span>
          </div>
        {{/if}}

        <div class="detail-row" style="display: flex; gap: 40px;">
          <div>
            <span class="detail-label">Date & Time</span>
            <span class="detail-value">{{metaData.date}} | {{metaData.slot}}</span>
          </div>
          <div>
            <span class="detail-label">Seats</span>
            <span class="detail-value">{{#each metaData.seatsBooked}}{{this}} {{/each}}</span>
          </div>
        </div>

        <div class="qr-section">
          <div class="qr-text">
            <strong>Admit One</strong><br/>
            Please present this QR code at the entrance.
          </div>
          <div class="qr-col">
            <img src="{{qrcode}}" alt="QR Code" width="90" height="90" />
          </div>
        </div>
      </div>
    </div>

    <div class="footer">
      This is an automatically generated digital ticket. Please do not reply to this email.
    </div>
  </div>
</body>
</html>
