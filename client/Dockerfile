# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Accept build args for Vite env vars
ARG VITE_AUTH_URL
ARG VITE_APP_URL
ARG VITE_PAYMENT_URL
ARG VITE_EMAIL_URL
ARG VITE_WEBSOCKET_URL
ARG VITE_WEBSOCKET
ARG VITE_CLIENT_BASE_URL
ARG VITE_RAZORPAY_KEY_ID
ARG VITE_JAUTH_BASE_URL
ARG VITE_JAUTH_CLIENT_ID

# Set them as env vars so Vite can embed them at build time
ENV VITE_AUTH_URL=$VITE_AUTH_URL
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_PAYMENT_URL=$VITE_PAYMENT_URL
ENV VITE_EMAIL_URL=$VITE_EMAIL_URL
ENV VITE_WEBSOCKET_URL=$VITE_WEBSOCKET_URL
ENV VITE_WEBSOCKET=$VITE_WEBSOCKET
ENV VITE_CLIENT_BASE_URL=$VITE_CLIENT_BASE_URL
ENV VITE_RAZORPAY_KEY_ID=$VITE_RAZORPAY_KEY_ID
ENV VITE_JAUTH_BASE_URL=$VITE_JAUTH_BASE_URL
ENV VITE_JAUTH_CLIENT_ID=$VITE_JAUTH_CLIENT_ID

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8000
CMD ["nginx", "-g", "daemon off;"]
